#!/usr/bin/env bash
#
# Leases the emulator for one command, so sessions in different worktrees
# take turns on it instead of interleaving. Every worktree installs the same
# applicationId, so a second session's install replaces the first's APK
# mid-run, and `wm size`, the listener grant and :smoke's Touch 'n Go package
# are global to the device. docs/agents/device-tests.md says when to use it, and
# .claude/hooks/emu_guard.py refuses device commands that do not.
#
#   emu [--ci-size] [--wait SECONDS] [--max-hold SECONDS] [--priority high|low] [--] COMMAND...
#   emu --status | --stop
#
# The lock is flock(2) on a file under ~/.cache, outside every worktree, so a
# worktree on an older branch with its own copy of this script still takes
# the same lock. The kernel drops it when the holder dies, so there is no
# stale lock to clear by hand.
#
# A lease boots the emulator if it is not running, and an emulator a lease
# booted is stopped after EMU_IDLE seconds with no lease: it held 5.0G of host
# memory whatever the GPU mode, because the emulator raises this image's RAM
# to 4096MB over the AVD's hw.ramSize=2048. One started by hand is left alone.
#
# EMU_POOL lists the serials to lease from, first free wins. One emulator by
# default: a second guest on this 12-core host starves rendering, which is
# how CI's render-timeout flakes were reproduced (see ci.yml's emulator job).

set -euo pipefail

# The whole command line, for a lease that requeue runs again.
argv=("$@")
# USR2 asks a holder to make way (requeue). Until its command runs there is
# nothing to stop, so it is only noted; bash's default would end emu itself.
preempted=0
trap 'preempted=1' USR2

lock_dir=${EMU_LOCK_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/pinged-emu}
pool=${EMU_POOL:-emulator-5554}
# One queue per pool: a lease for a free emulator must not wait behind the
# sessions queued for another, as one for emulator-5560 did behind 5554's.
queue=$lock_dir/queue/${pool// /+}
# Longer than one full connectedDebugAndroidTest (~10 min of device time on
# CI), so a lease queued behind one does not give up and retry. Longer than
# the Bash tool's 600s ceiling too, which is why leases run in the background.
wait_s=${EMU_WAIT:-1800}
idle_s=${EMU_IDLE:-900}
# How long one lease may hold the emulator before its command is stopped, so
# a hung command cannot hold every other session up: a script stuck on an
# `adb shell` that never returned held it 27 minutes, twice running, on
# 2026-10-16. Twice the longest run that should need one lease, a full
# connectedDebugAndroidTest (~10 min on CI). 0 lifts the limit.
max_hold_s=${EMU_MAX_HOLD:-1200}
# Between TERM and KILL, for a command that does not stop on TERM.
grace_s=${EMU_KILL_GRACE:-10}
boot_wait_s=${EMU_BOOT_WAIT:-300}
avd=${EMU_AVD:-Pixel_10a}
emulator=${EMU_EMULATOR:-${ANDROID_HOME:-$HOME/Android/Sdk}/emulator/emulator}
# CI's flags (ci.yml's EMULATOR_OPTIONS), so a render timing seen here is the
# one CI sees. -no-snapshot: on this host a cold boot took 12s and stopped in
# 2s; a quickboot took 3s but its save made the stop 11s and kept ~4G on disk.
flags=${EMU_FLAGS:--no-window -gpu swiftshader_indirect -no-audio -no-boot-anim -camera-back none -no-snapshot}
ci_size=0
priority=normal

usage() {
    sed -n '10,11p' "$0" | sed 's/^# *//'
}

# A ticket's queue class, from the order its name starts with. A class is a
# leading digit on the 19-digit order: 0 sorts before every ordinary ticket and
# 9 after, so an older copy of this script, sorting by name, queues them in
# the same order without reading them. Within a class the clock still decides.
class_of() {
    case ${#1}:$1 in
        20:0*) echo high ;;
        20:9*) echo low ;;
        *) echo normal ;;
    esac
}

# Prints each serial's holder, or that it is free. The holder file is only a
# label: whether a serial is held is the lock's answer, not the file's.
describe() {
    local s lock holder since where pid cmd
    for s in $pool; do
        lock=$lock_dir/$s.lock
        if [ ! -e "$lock" ] || flock -n "$lock" true; then
            printf '  %s: free\n' "$s"
            continue
        fi
        holder=$lock_dir/$s.holder
        if [ -s "$holder" ]; then
            IFS=$'\t' read -r since where pid cmd <"$holder"
            printf '  %s: held by %s for %ss, pid %s: %s\n' \
                "$s" "$where" "$(($(date +%s) - since))" "$pid" "$cmd"
        else
            printf '  %s: held\n' "$s"
        fi
    done
    local t since where cmd n=0
    for t in $(ls "$queue" 2>/dev/null | sort); do
        n=$((n + 1))
        IFS=$'\t' read -r since where cmd <"$queue/$t" || continue
        local class
        class=$(class_of "${t%%-*}")
        printf '  queued %s: %s for %ss%s: %s\n' "$n" "$where" "$(($(date +%s) - since))" \
            "$([ "$class" = normal ] || echo ", $class priority")" "$cmd"
    done
}

# A process's start time in clock ticks since boot (stat field 22, counted
# after the parenthesised name, which may hold spaces). With the pid it names
# one process for good: a reused pid has a different start time.
started() {
    sed 's/.*) //' "/proc/$1/stat" 2>/dev/null | cut -d' ' -f20
}

# Waiters queued before this one that are still alive. flock alone is not
# first come, first served: every waiter polls, and whichever polls first
# after a release wins, so a session that queued first watched a later one
# take the emulator for a full suite. A ticket whose process is gone is
# removed, or a killed waiter would hold up the queue for good.
#
# A waiter named in .front ("pid start", the pane's Run now) goes before
# every ticket, its own included; a .front whose process is gone is removed.
#
# A waiter finds its own ticket by its pid and start time, not by the name it
# filed it under: the pane changes a waiter's priority by renaming its ticket.
# 2>/dev/null goes before the <: redirections apply left to right, so after
# it the open's own error, when there is no .front, is printed every poll.
ahead() {
    local t pid start n=0 front_pid= front_start=
    if read -r front_pid front_start 2>/dev/null <"$queue/.front"; then
        if [ "$front_pid" = "$$" ]; then
            echo 0
            return
        fi
        if [ "$(started "$front_pid")" = "$front_start" ]; then
            n=1
        else
            rm -f "$queue/.front"
            front_pid=
        fi
    fi
    for t in $(ls "$queue" | sort); do
        [ "${t#*-}" = "$me" ] && break
        pid=${t#*-}; start=${pid#*-}; pid=${pid%-*}
        [ "$pid" = "$front_pid" ] && continue
        if [ "$(started "$pid")" = "$start" ]; then
            n=$((n + 1))
        else
            rm -f "$queue/$t"
        fi
    done
    echo "$n"
}

# Every adb call closes fd 9. The first adb call with no server running
# starts the server, which inherits the caller's descriptors and lives on:
# given the lock, it held the emulator against every session after the
# lease ended.
adb() {
    command adb "$@" 9>&-
}

online() {
    adb -s "$1" get-state >/dev/null 2>&1 &&
        [ "$(adb -s "$1" shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')" = 1 ]
}

# Kills the emulator and waits for its process to go, so a boot that follows
# does not meet the old instance's lock on the AVD. Caller holds the lease.
stop() {
    local serial=$1 i
    adb -s "$serial" emu kill >/dev/null 2>&1 || true
    for i in $(seq 60); do
        adb -s "$serial" get-state >/dev/null 2>&1 || break
        sleep 1
    done
    rm -f "$lock_dir/$serial.booted"
}

# Run detached after a lease that found a booted emulator. Every such lease
# starts one, and only the last survives the timestamp check: an earlier
# reaper finds a newer release and leaves it to that lease's reaper.
#
# Every decision goes to <serial>.reaper.log, with the reaper's pid: an
# emulator once stayed up past its idle stop with no reaper left running and
# no way to tell why. A reaper whose start line has no ending line was killed
# with SIGKILL.
reap() {
    local serial=$1 released
    reap_log() {
        printf '%s pid=%s %s\n' "$(date '+%F %T')" "$$" "$*" >>"$lock_dir/$serial.reaper.log"
    }
    released=$(cat "$lock_dir/$serial.released" 2>/dev/null) || { reap_log "quit: no release recorded"; exit 0; }
    reap_log "start: stops $serial at $(date -d "@$((released / 1000000000 + idle_s))" '+%T') unless leased again"
    local sig
    for sig in TERM INT HUP; do
        # shellcheck disable=SC2064 # sig is meant to expand now
        trap "reap_log 'ended by SIG$sig'; exit 0" "$sig"
    done
    # In the background and waited for: bash runs a trap only once a
    # foreground command returns, so a reaper killed mid-sleep would
    # otherwise log nothing until its sleep had run out.
    sleep "$idle_s" &
    wait $!
    exec 9>>"$lock_dir/$serial.lock"
    flock -n 9 || { reap_log "quit: $serial is leased"; exit 0; }
    [ -e "$lock_dir/$serial.booted" ] || { reap_log "quit: $serial was not booted by emu, or already stopped"; exit 0; }
    [ "$(cat "$lock_dir/$serial.released" 2>/dev/null)" = "$released" ] ||
        { reap_log "quit: a later lease released $serial; its reaper takes over"; exit 0; }
    reap_log "stopping $serial after ${idle_s}s idle"
    printf '%s\treaper\t%s\tstopping after %ss idle\n' "$(date +%s)" "$$" "$idle_s" >"$lock_dir/$serial.holder"
    stop "$serial"
    rm -f "$lock_dir/$serial.holder"
    reap_log "stopped $serial"
}

mkdir -p "$lock_dir" "$queue"
stop_now=0
while [ $# -gt 0 ]; do
    case $1 in
        --ci-size) ci_size=1; shift ;;
        --wait) wait_s=$2; shift 2 ;;
        --max-hold) max_hold_s=$2; shift 2 ;;
        --priority)
            case $2 in
                high | normal | low) priority=$2; shift 2 ;;
                *) printf 'emu: --priority is high, normal or low, not %s\n' "$2" >&2; exit 64 ;;
            esac ;;
        --status) describe; exit 0 ;;
        --stop) stop_now=1; shift ;;
        --reap) reap "$2"; exit 0 ;;
        -h | --help) usage; exit 0 ;;
        --) shift; break ;;
        -*) printf 'emu: unknown option %s\n' "$1" >&2; usage >&2; exit 64 ;;
        *) break ;;
    esac
done
[ $# -gt 0 ] || [ "$stop_now" = 1 ] || { usage >&2; exit 64; }

where=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
where=${where##*/}

# A lease put back by Run now (see requeue) sorts before every ordinary
# ticket, so it runs next after the waiter that went first.
order=$(date +%s%N)
case $priority in
    high) order=0$order ;;
    low) order=9$order ;;
esac
if [ -n "${EMU_REQUEUED:-}" ]; then order=0000000000000000001; fi
unset EMU_REQUEUED
me=$$-$(started $$)
printf '%s\t%s\t%s\n' "$(date +%s)" "$where" "${*:-stop}" >"$queue/$order-$me"
# By pid and start time, whatever the ticket has been renamed to since.
leave_queue() {
    rm -f "$queue"/*-"$me"
}
trap leave_queue EXIT

serial=
deadline=$((SECONDS + wait_s))
told=0
slots=$(wc -w <<<"$pool")
while :; do
    if [ "$(ahead)" -lt "$slots" ]; then
        for s in $pool; do
            exec 9>>"$lock_dir/$s.lock"
            if flock -n 9; then
                serial=$s
                leave_queue
                if read -r front_pid _ 2>/dev/null <"$queue/.front" && [ "$front_pid" = "$$" ]; then
                    rm -f "$queue/.front"
                fi
                break 2
            fi
            exec 9>&-
        done
    fi
    if [ "$SECONDS" -ge "$deadline" ]; then
        printf 'emu: no emulator free after %ss. Rerun, or --wait longer.\n' "$wait_s" >&2
        describe >&2
        exit 75
    fi
    if [ "$told" = 0 ]; then
        printf 'emu: waiting up to %ss for\n' "$wait_s" >&2
        describe >&2
        told=1
    fi
    sleep 1
done

holder=$lock_dir/$serial.holder
printf '%s\t%s\t%s\t%s\n' "$(date +%s)" "$where" "$$" "${*:-stop}" >"$holder"

if [ "$stop_now" = 1 ]; then
    stop "$serial"
    rm -f "$holder"
    exit 0
fi

# Kills what an `adb shell` left running on the device: a process of the
# shell user re-parented to init once the shell that started it exited (a
# backgrounded loop, say), which outlives its lease and starves the next one.
# A live adb session's own processes stay under adbd and are left alone; on
# this image the only shell process init parents is adbd itself.
sweep_device() {
    local left
    left=$(adb -s "$serial" shell "ps -A -o PID=,PPID=,USER=,NAME= | awk '\$2==1 && \$3==\"shell\" && \$4!=\"adbd\" {print \$1}'" 2>/dev/null |
        tr -d '\r') || return 0
    [ -n "$left" ] || return 0
    printf 'emu: killed %s process(es) left running on %s\n' "$(wc -w <<<"$left")" "$serial" >&2
    # shellcheck disable=SC2086 # left is a list of pids
    adb -s "$serial" shell kill -9 $left >/dev/null 2>&1 || true
}

reset_size() {
    adb -s "$serial" shell wm size reset >/dev/null 2>&1 || true
    adb -s "$serial" shell wm density reset >/dev/null 2>&1 || true
}

# Runs while fd 9 is still open, so the next holder's label is never removed.
on_exit() {
    if [ -n "${watchdog:-}" ]; then kill "$watchdog" 2>/dev/null || true; fi
    if [ -n "${child:-}" ]; then sweep_device; fi
    if [ "$ci_size" = 1 ]; then reset_size; fi
    rm -f "$holder"
    if [ -e "$lock_dir/$serial.booted" ] && [ "$idle_s" -gt 0 ]; then
        date +%s%N >"$lock_dir/$serial.released"
        setsid "$0" --reap "$serial" </dev/null >/dev/null 2>&1 9>&- &
        local log=$lock_dir/$serial.reaper.log
        printf '%s pid=%s lease by %s released %s, started reaper pid=%s\n' \
            "$(date '+%F %T')" "$$" "$where" "$serial" "$!" >>"$log"
        if [ "$(wc -l <"$log")" -gt 400 ]; then
            tail -n 200 "$log" >"$log.tmp" && mv "$log.tmp" "$log"
        fi
    fi
}
trap on_exit EXIT

if ! online "$serial"; then
    # Several instances of one AVD run only if every one is -read-only.
    read_only=
    if [ "$(wc -w <<<"$pool")" -gt 1 ]; then read_only=-read-only; fi
    printf 'emu: booting %s on %s\n' "$avd" "$serial" >&2
    # shellcheck disable=SC2086 # flags is a word list
    setsid "$emulator" -avd "$avd" -port "${serial#emulator-}" $read_only $flags \
        </dev/null >"$lock_dir/$serial.emulator.log" 2>&1 9>&- &
    touch "$lock_dir/$serial.booted"
    boot_deadline=$((SECONDS + boot_wait_s))
    until online "$serial"; do
        if [ "$SECONDS" -ge "$boot_deadline" ]; then
            printf 'emu: %s did not boot in %ss; the emulator said:\n' "$serial" "$boot_wait_s" >&2
            tail -5 "$lock_dir/$serial.emulator.log" >&2
            stop "$serial"
            exit 69
        fi
        sleep 1
    done
fi

# A holder killed with SIGKILL never ran its reset, and every later test
# would run at 320x640 without asking for it.
if adb -s "$serial" shell wm size 2>/dev/null | grep -q Override ||
    adb -s "$serial" shell wm density 2>/dev/null | grep -q Override; then
    printf 'emu: %s had a size or density override left by a dead holder; reset it\n' "$serial" >&2
    reset_size
fi

sweep_device

# What ci.yml's `disable-animations: true` sets, so a timing seen here is the
# one CI sees. On every lease rather than at boot: the settings live in
# userdata, which outlives a boot, and anything may have turned them back on.
for scale in window_animation_scale transition_animation_scale animator_duration_scale; do
    adb -s "$serial" shell settings put global "$scale" 0
done

if [ "$ci_size" = 1 ]; then
    adb -s "$serial" shell wm size 320x640
    adb -s "$serial" shell wm density 160
fi

export ANDROID_SERIAL=$serial

# In the background, so a TERM reaches the reset now rather than after the
# command finishes. Without job control bash gives a background job
# /dev/null for stdin, hence fd 3. `9>&-` keeps the lock out of anything the
# command leaves running after it returns: a process that inherited fd 9
# would hold the emulator for every session until it died. `setsid` makes
# the command lead a process group of its own, so a stop reaches its
# children too: killing the command alone left a hung `adb shell` behind.
exec 3<&0
setsid "$@" <&3 9>&- &
child=$!

# The signal to the command's whole group, then KILL to what outlasts grace_s.
stop_command() {
    kill -"$1" -- -"$child" 2>/dev/null || true
    local i
    for i in $(seq "$grace_s"); do
        kill -0 -- -"$child" 2>/dev/null || return 0
        sleep 1
    done
    kill -KILL -- -"$child" 2>/dev/null || true
}

on_timeout() {
    printf 'emu: %s held %s for %ss, the --max-hold limit; stopped it\n' "$*" "$serial" "$max_hold_s" >&2
    stop_command TERM
    exit 124
}

trap 'stop_command TERM; exit 143' TERM
trap 'stop_command INT; exit 130' INT
trap 'on_timeout "$@"' USR1

# Another waiter was put first (the pane's Run now, which writes .front and
# sends USR2): this lease stops its command, leaves the device as a lease's
# end does, gives up the emulator and runs itself again, same pid and same
# arguments, with a ticket that sorts first. Its caller sees the command take
# longer, not fail.
requeue() {
    printf 'emu: another lease was put first; %s will run again after it\n' "$*" >&2
    trap - EXIT
    if [ -n "${watchdog:-}" ]; then kill "$watchdog" 2>/dev/null || true; fi
    sweep_device
    if [ "$ci_size" = 1 ]; then reset_size; fi
    rm -f "$holder"
    exec 9>&-
    EMU_REQUEUED=1 exec "$0" "${argv[@]}"
}
trap 'preempted=1; stop_command TERM' USR2
if [ "$preempted" = 1 ]; then stop_command TERM; fi

if [ "$max_hold_s" -gt 0 ]; then
    (sleep "$max_hold_s" && kill -USR1 $$) </dev/null >/dev/null 2>&1 9>&- &
    watchdog=$!
fi
status=0
wait "$child" || status=$?
if [ "$preempted" = 1 ]; then requeue "$@"; fi
exit "$status"
