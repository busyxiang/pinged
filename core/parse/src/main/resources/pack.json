{
  "pack_version": 12,
  "fragments": {
    "amount": "(?:RM|MYR)\\s?(?<amount>[0-9,]+(?:\\.[0-9]{1,2})?)"
  },
  "merchant_normalization": {
    "acquirer_prefixes": [
      "TNG*", "GRAB*", "PYMT-", "DUITNOWQR-", "DUITNOW-", "FPX-", "IBG-", "MBB-"
    ],
    "trailing_noise_suffixes": [
      " SDN BHD", " SDN. BHD.", " SDN BHD.", " S/B", " BERHAD", " BHD", " MY", " MYS",
      " via DuitNow QR", " via DuitNow", " via FPX", " via IBG"
    ],
    "title_case_exceptions": [
      "TNG", "KK", "McDonald's"
    ]
  },
  "shared_rules": [
    {
      "id": "duitnow-paid-v1", "priority": 100,
      "direction": "EXPENSE", "confidence": "HIGH",
      "requires": {
        "text_contains_all": ["You have paid"],
        "text_contains_none": ["gagal", "tidak berjaya", "unsuccessful", "failed", "declined"],
        "field": "text"
      },
      "pattern": "You have paid {{amount}} to (?<merchant>.+)$"
    },
    {
      "id": "duitnow-paid-body-v1", "priority": 90,
      "direction": "EXPENSE", "confidence": "HIGH",
      "requires": {
        "text_contains_all": ["You have paid"],
        "text_contains_none": ["gagal", "tidak berjaya", "unsuccessful", "failed", "declined"]
      },
      "pattern": "You have paid {{amount}} to "
    }
  ],
  "packages": [
    {
      "package": "my.com.tngdigital.ewallet",
      "label": "Touch 'n Go eWallet",
      "reject": [
        { "id": "tng-otp", "any_of": ["OTP", "TAC", "do not share", "jangan kongsi"] },
        { "id": "tng-failed", "any_of": ["gagal", "tidak berjaya", "unsuccessful", "failed", "declined"] },
        { "id": "tng-promo", "any_of": ["voucher", "diskaun", "% off"] },
        { "id": "tng-approval", "any_of": ["approve your transaction"] }
      ],
      "rules": [
        {
          "id": "tng-payment-v1", "priority": 100,
          "direction": "EXPENSE", "confidence": "HIGH",
          "requires": {
            "text_contains_all": ["Payment of", "successful"],
            "text_contains_none": ["gagal", "tidak berjaya", "unsuccessful", "failed", "declined"]
          },
          "pattern": "Payment of {{amount}} to (?<merchant>.+?) successful"
        },
        {
          "id": "tng-paid-for-v1", "priority": 100,
          "direction": "EXPENSE", "confidence": "HIGH",
          "requires": {
            "text_contains_all": ["You have paid"],
            "text_contains_none": ["gagal", "tidak berjaya", "unsuccessful", "failed", "declined"],
            "field": "text"
          },
          "pattern": "You have paid {{amount}} for (?<merchant>.+)$"
        },
        {
          "id": "tng-travel-pass-v1", "priority": 110,
          "direction": "EXPENSE", "confidence": "HIGH",
          "requires": {
            "text_contains_all": ["Travel Pass:", "You have paid"],
            "text_contains_none": ["gagal", "tidak berjaya", "unsuccessful", "failed", "declined"],
            "field": "text"
          },
          "pattern": "You have paid {{amount}} for (?:your )?(?<merchant>.+?)\\. View"
        },
        {
          "id": "tng-alipay-plus-v1", "priority": 100,
          "direction": "EXPENSE", "confidence": "HIGH",
          "requires": {
            "text_contains_all": ["You have paid"],
            "text_contains_none": ["gagal", "tidak berjaya", "unsuccessful", "failed", "declined"],
            "field": "text"
          },
          "pattern": "You have paid {{amount}} at (?<merchant>.+)$"
        },
        {
          "id": "tng-deducted-v1", "priority": 100,
          "direction": "EXPENSE", "confidence": "HIGH",
          "requires": {
            "text_contains_all": ["has been deducted from your"],
            "text_contains_none": ["gagal", "tidak berjaya", "unsuccessful", "failed", "declined"],
            "field": "text"
          },
          "pattern": "(?<merchant>.+?): {{amount}} has been deducted"
        },
        {
          "id": "tng-deducted-body-v1", "priority": 100,
          "direction": "EXPENSE", "confidence": "HIGH",
          "requires": {
            "text_contains_all": ["has been deducted from your"],
            "text_contains_none": ["gagal", "tidak berjaya", "unsuccessful", "failed", "declined"],
            "field": "bigText"
          },
          "pattern": "(?<merchant>.+?): {{amount}} has been deducted"
        },
        {
          "id": "tng-reload-v1", "priority": 90,
          "direction": "EXPENSE", "confidence": "REVIEW",
          "kind": "TRANSFER_SUSPECT", "exclusion_reason": "TRANSFER",
          "requires": {
            "text_contains_all": ["Reload"],
            "text_contains_none": ["gagal", "tidak berjaya", "unsuccessful", "failed", "declined"]
          },
          "pattern": "Reload of {{amount}}"
        }
      ]
    },
    {
      "package": "com.maybank2u.life",
      "label": "Maybank MAE",
      "reject": [
        { "id": "mae-otp", "any_of": ["TAC", "one-time", "do not share"] },
        { "id": "mae-failed", "any_of": ["gagal", "tidak berjaya", "unsuccessful", "failed", "declined"] },
        { "id": "mae-approval", "any_of": ["transaction to be approved"] }
      ],
      "rules": [
        {
          "id": "mae-refund-my-v1", "priority": 95,
          "direction": "REFUND", "confidence": "HIGH",
          "requires": {
            "text_contains_any": ["bayaran balik", "pemulangan wang"],
            "text_contains_none": ["gagal", "tidak berjaya", "unsuccessful", "failed", "declined"]
          },
          "pattern": "(?:Bayaran balik|Pemulangan wang) {{amount}} daripada (?<merchant>.+?) telah"
        },
        {
          "id": "mae-scan-pay-v1", "priority": 100,
          "direction": "EXPENSE", "confidence": "HIGH",
          "requires": {
            "text_contains_all": ["Successful payment of"],
            "text_contains_none": ["gagal", "tidak berjaya", "unsuccessful", "failed", "declined"]
          },
          "pattern": "Successful payment of {{amount}} to (?<merchant>.+?)\\. REF"
        },
        {
          "id": "mae-card-bill-v1", "priority": 110,
          "direction": "EXPENSE", "confidence": "REVIEW",
          "kind": "TRANSFER_SUSPECT", "exclusion_reason": "CARD_PAYMENT",
          "requires": {
            "text_contains_all": ["Successful payment of"],
            "text_contains_any": ["Master Card", "MasterCard"],
            "text_contains_none": ["gagal", "tidak berjaya", "unsuccessful", "failed", "declined"]
          },
          "pattern": "Successful payment of {{amount}} to (?<merchant>.+?)\\. REF"
        },
        {
          "id": "mae-fpx-v1", "priority": 110,
          "direction": "EXPENSE", "confidence": "REVIEW",
          "requires": {
            "text_contains_all": ["Successful payment of", "FPX ID"],
            "text_contains_none": ["gagal", "tidak berjaya", "unsuccessful", "failed", "declined"]
          },
          "pattern": "Successful payment of {{amount}} to (?<merchant>.+?) on [0-9]{1,2} [A-Za-z]{3} [0-9]{4}"
        },
        {
          "id": "mae-card-spend-v1", "priority": 100,
          "direction": "EXPENSE", "confidence": "HIGH",
          "requires": {
            "text_contains_all": ["just spent"],
            "text_contains_none": ["gagal", "tidak berjaya", "unsuccessful", "failed", "declined"]
          },
          "pattern": "just spent {{amount}} at (?<merchant>.+?) with your"
        }
      ]
    }
  ]
}
